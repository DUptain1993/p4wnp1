#!/bin/bash
# Disable WiFi monitor mode.
# Usage: monstop [source-interface]
#   source-interface defaults to wlan0, matching monstart's default
interface=${1:-wlan0}
mon_interface="${interface}mon"

ifconfig "${mon_interface}" down
sleep 1
iw dev "${mon_interface}" del
del_status=$?

# See monstart for why this checks the sysfs bus instead of the interface name.
if command -v nexutil >/dev/null 2>&1 \
    && [ -e "/sys/class/net/${interface}/device/subsystem" ] \
    && [ "$(basename "$(readlink -f "/sys/class/net/${interface}/device/subsystem")")" = "sdio" ]; then
    nexutil -m0 || true
fi

exit "${del_status}"
