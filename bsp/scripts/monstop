#!/bin/bash
# Disable WiFi monitor mode.
# Usage: monstop [source-interface]
#   source-interface defaults to wlan0, matching monstart's default
interface=${1:-wlan0}
mon_interface="${interface}mon"

ifconfig "${mon_interface}" down
sleep 1
iw dev "${mon_interface}" del

if [ "${interface}" = "wlan0" ] && command -v nexutil >/dev/null 2>&1; then
    nexutil -m0 || true
fi
